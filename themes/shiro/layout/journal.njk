{% extends "_layout.njk" %}
{% from "_partial/components/travel-art.njk" import country_mark %}
{% block content %}
{% set country = travel_country(page) %}
<article class="content-article standalone-page travel-article">
    <header class="article-header">
        <nav class="travel-country-tabs" aria-label="旅行国家"><h1>
            {% for destination in travel_countries() %}
            {% if not loop.first %}<span aria-hidden="true"> / </span>{% endif %}<a href="{{ url_for(destination.route) }}"{% if country.code == destination.code %} aria-current="page"{% endif %}>{{ country_mark(destination.mark) }}<span>{{ destination.label }}</span></a>
            {% endfor %}
        </h1></nav>
    </header>
    {% include "_partial/components/travel-journal.njk" %}
</article>
{% endblock %}

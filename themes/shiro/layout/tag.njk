{% extends "_layout.njk" %}
{% import "_macro/archive.njk" as archive with context %}
{% from "_macro/ui.njk" import render_tag with context %}
{% block content %}<section class="archive-page"><header class="section-intro"><div><p class="eyebrow">Collected by keyword</p><h1>{% if is_tag() %}{{ page.tag }}{% else %}Tags{% endif %}</h1></div></header>{% if is_tag() %}{{ archive.render_list(page.posts.sort('date', -1)) }}{% include "_partial/common/pagination.njk" %}{% else %}<div class="post-tags">{% for tag in site.tags.sort('name', 1).toArray() %}{{ render_tag(tag, true) }}{% endfor %}</div>{% endif %}</section>{% endblock %}

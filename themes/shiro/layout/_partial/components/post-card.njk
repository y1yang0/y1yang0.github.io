<article class="post-entry">
    <div class="entry-date"><time datetime="{{ date(post.date, 'YYYY-MM-DD') }}"><span>{{ date(post.date, 'MMM DD') }}</span><span class="entry-year">{{ date(post.date, 'YYYY') }}</span></time></div>
    <div class="entry-content">
        <h2><a href="{{ url_for(post.path) }}">{{ post.title }}</a></h2>
        {% if post.excerpt or theme.excerpt.fallback.enabled %}{% if post.travel_journal %}{% set preview = post.description %}{% else %}{% set preview = journal_excerpt(post, theme.excerpt.fallback.length) %}{% endif %}{% if preview %}<p class="entry-excerpt">{{ preview }}</p>{% endif %}{% endif %}
        <div class="entry-bottom">
            {% if not post.travel_journal %}<span class="entry-meta-item">{{ wordcount(post.content) }} words</span>{% endif %}
            {% if post.categories.length %}<span class="entry-meta-item">{% if not post.travel_journal %}<span class="entry-separator" aria-hidden="true">·</span>{% endif %}<span>{% for cat in post.categories.toArray() %}<a class="entry-topic" href="{{ url_for(cat.path) }}">{{ cat.name }}</a>{% if not loop.last %}<span class="entry-separator" aria-hidden="true"> / </span>{% endif %}{% endfor %}</span></span>{% endif %}
        </div>
    </div>
    <a class="entry-open" href="{{ url_for(post.path) }}" aria-label="Read {{ post.title }}"><span aria-hidden="true">→</span></a>
</article>

{# Small pen sketches for country navigation; text supplies accessible names. #}
{% macro country_mark(country) %}
<svg class="travel-country-mark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 56 56" width="42" height="42" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {% if country == 'china' %}
    <path fill="var(--sage)" fill-opacity=".42" stroke="none" d="M15 34q13 4 27 0l-1 10H16Z"/>
    <path d="M28 6v5m-2-4q2-2 4 0M18 19q7-3 10-8 3 5 10 8-10 3-20 0Zm2 3v4m16-4v4M13 29q10-3 15-9 5 6 16 9-16 4-31 0Zm4 4v3m23-3v3M9 39q12-3 19-8 7 5 19 8-19 4-38 0Zm6 3v6m26-6v6m-18-6v6m10-6v6M11 48q17 1 34 0M8 51q20-1 40 0"/>
    <path stroke="var(--accent)" stroke-width="1.25" d="M19 20q9 2 18 0m-21 10q12 3 25 0"/>
    <path opacity=".23" stroke-width=".8" d="M10 40q18 5 37 0M9 53q20-1 37 0"/>
    {% elif country == 'japan' %}
    <path fill="var(--accent)" fill-opacity=".8" stroke="var(--accent)" stroke-width=".9" d="M45 15c.2 4-2.6 6.8-6.1 6.5-3.5.1-6-2.5-5.8-6 .1-3.3 2.6-5.9 6.1-5.8 3.3-.1 6 2.2 5.8 5.3Z"/>
    <path fill="var(--sage)" fill-opacity=".42" stroke="none" d="m7 43 13-17 4 4 4-3 5 4 4-4 13 16Z"/>
    <path d="M5 44c7-5 14-17 19-24l7 .3C37 29 43 39 51 44M19 28l5 3 4-3 5 4 4-3M8 46q17-2 40 0M14 50q8-1 15 0m8-.5 8 .5"/>
    <path opacity=".3" stroke-width=".8" d="M7 44c9-6 14-16 18-22m9 13 4 5m-17-4-4 6M11 48q10-1 17-.5"/>
    {% else %}
    <path d="M28 8c11-.2 20 8.5 20 20.1C48 39 39.3 48 28 47.8 16.9 48 8 39.2 8.2 28 8 16.8 16.7 8 28 8Zm0 3v4m0 26v4M11 28h4m26 0h4"/>
    <path fill="var(--accent)" fill-opacity=".65" stroke="var(--accent)" d="m35 20-4 11-10 5 4-11Z"/>
    <path opacity=".25" stroke-width=".8" d="M28 5c13 .2 23 10.2 23 23M5 29c.2 12 10 22 22 22"/>
    {% endif %}
</svg>
{% endmacro %}

{# Empty-album illustration; colours follow the site palette. #}
{% macro travel_scene() %}
<svg class="travel-art travel-art--water" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 360 130" width="360" height="130" fill="none" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMax meet">
    <path fill="var(--sage)" opacity=".58" d="M16 86c23-4 32-22 49-19 18 4 23 24 42 22 25-3 40-34 62-28 16 4 25 27 43 24 26-4 42-21 61-16 25 7 38 21 72 19v15H16Z"/>
    <circle cx="279" cy="40" r="9" fill="var(--accent)" opacity=".7"/>
    <g stroke="var(--ink)" stroke-linecap="round" stroke-linejoin="round">
        <path opacity=".5" stroke-width="1.35" d="M32 103q15-29 11-77m0 13q17-19 47-21m-45 9-15-8"/>
        <path opacity=".4" stroke-width="1.05" d="M57 29q12 17 6 43m13-48q12 15 9 34m-41-10q12 14 8 39m11-34 4 8m-3 5-4 8m24-31 3 8"/>
        <path opacity=".65" stroke-width="1.3" d="M97 96q47-43 94 0m-84-1q37-30 73 0m-91-4q53-46 105 0m-91-11-2-8m25-2-1-8m24 6v-8m24 13 2-8m-65 33h18m32 0h17"/>
        <path opacity=".38" stroke-width="1.1" d="M19 105h58m119-3c28-3 54-2 78-2m25 6h41m-309 13h50m27-8h22m70 10h58m31-8h41"/>
        <path opacity=".65" stroke-width="1.2" d="m224 107 6 5h25l6-5q-19 5-37 0Zm15-1V86m0 0q-10 3-12 18h12m5-8 14 17m-30 6h24"/>
    </g>
</svg>
{% endmacro %}

{% from "_partial/components/travel-art.njk" import travel_scene with context %}
{% set travel_stats = travel_journal_stats(page) %}
{% set country = travel_country(page) %}
{% set location_label = '地区' if country.mapLevel == 'province' else '城市' %}
<div class="travel-journal" id="travelJournal" data-view="atlas" data-country="{{ country.code }}" data-country-name="{{ country.name }}" data-map-level="{{ country.mapLevel }}" data-unit="{{ country.unit }}" data-coverage-label="{{ country.coverageLabel }}" lang="zh-CN">
    <div class="travel-atlas-layout">
        <section class="travel-atlas" aria-label="{{ location_label }}旅行地图">
            <header class="travel-atlas-heading">
                <div class="travel-atlas-actions"><div class="travel-map-stats"><p class="travel-coverage"><span>{{ country.coverageLabel }}</span><strong id="travelCoverage">{{ travel_stats.coverage }}</strong></p><p class="travel-visited-count"><span>{{ country.countLabel }}</span><strong id="travelPlaceCount">{{ travel_stats.visited }}</strong></p></div><button type="button" id="travelAllCities" aria-label="返回{{ country.name }}全部{{ location_label }}地图" hidden>← 返回地图</button></div>
            </header>
            <nav id="travelAlbumCities" class="travel-album-cities" aria-label="已记录的{{ location_label }}" hidden></nav>
            <div class="travel-map-stage">
                <svg id="travelMap" xmlns="http://www.w3.org/2000/svg" viewBox="{{ travel_map_viewbox() }}" width="1000" height="760" role="group" tabindex="0" aria-labelledby="travelMapTitle" aria-describedby="travelKeyboardHint"><title id="travelMapTitle">{{ country.name }}{{ location_label }}旅行地图</title>{% if country.credit %}<desc>{{ country.credit }}</desc>{% endif %}<g id="travelMapCanvas" class="travel-map-canvas" aria-hidden="true">{{ travel_map_markup() | safe }}</g></svg>
                <div id="travelMapStatus" class="travel-map-status" role="status" hidden><button type="button" id="travelRetry" hidden>重新初始化</button></div>
                <div id="travelMapTooltip" class="travel-map-tooltip" hidden></div>
                <div class="travel-map-tools" role="group" aria-label="地图缩放"><button type="button" data-travel-zoom="in" aria-label="放大地图" title="放大" disabled>＋</button><button type="button" data-travel-zoom="out" aria-label="缩小地图" title="缩小" disabled>−</button><button type="button" data-travel-zoom="reset" aria-label="恢复全国视图" title="全国视图" disabled>⌖</button></div>
            </div>
            <p id="travelKeyboardHint" class="visually-hidden">地图获得焦点后，可用方向键切换附近{{ location_label }}，按加号或减号缩放，按零恢复全国视图。</p>
        </section>
        <aside class="travel-notebook" id="travelDetails" aria-labelledby="travelCityName" hidden>
            <header class="travel-city-heading"><p class="travel-kicker" id="travelActiveProvince">{{ location_label }}相册</p><h2 id="travelCityName" tabindex="-1">{% if country.mapLevel == 'province' %}选一个地区{% else %}选一座城市{% endif %}</h2><p id="travelCityMeta">暂无记录</p></header>
            <div id="travelEntries" class="travel-entries"></div>
            <div id="travelEmpty" class="travel-empty">{{ travel_scene() }}<p>暂无照片</p></div>
        </aside>
    </div>
    <p id="travelStatus" class="visually-hidden" role="status" aria-live="polite"></p>
    <script id="travelMapData" type="application/json">{{ travel_map_payload() | safe }}</script>
    <script id="travelJournalData" type="application/json">{{ travel_journal_payload(page) | safe }}</script>
    <noscript><p class="travel-noscript">交互地图需要启用 JavaScript；旅行记录的数据保存在这篇手记中。</p></noscript>
    <dialog id="travelPhotoViewer" class="travel-photo-viewer" aria-label="旅行照片预览"><header><span id="travelViewerCounter"></span><button type="button" data-close-photo aria-label="关闭照片">×</button></header><figure><div id="travelViewerStage" class="travel-viewer-stage"><img id="travelViewerImage" alt="" draggable="false"><div class="travel-photo-lens-layer" aria-hidden="true"><div id="travelPhotoLens" class="travel-photo-lens" hidden><canvas id="travelPhotoMagnifier" width="190" height="190"></canvas><span class="travel-photo-lens-crosshair"></span><span class="travel-photo-lens-label">3×</span></div></div></div><figcaption id="travelViewerCaption"></figcaption></figure><p id="travelViewerStatus" class="travel-viewer-status" role="status" aria-live="polite"></p><button type="button" id="travelViewerRetry" hidden>重新加载照片</button><nav aria-label="浏览照片"><button type="button" data-prev-photo aria-label="上一张照片">←</button><button type="button" id="travelViewerReset" hidden>恢复全图</button><button type="button" data-next-photo aria-label="下一张照片">→</button></nav><p class="travel-viewer-hint">左右滑动切图 · 双指缩放 · 双击放大</p></dialog>
</div>

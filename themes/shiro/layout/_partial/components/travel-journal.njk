{% from "_partial/components/travel-art.njk" import travel_scene with context %}
{% set travel_stats = travel_journal_stats(page) %}
<div class="travel-journal prose-shiro" id="travelJournal" data-view="atlas" lang="zh-CN">
    <div class="travel-atlas-layout">
        <section class="travel-atlas" aria-labelledby="travelMapHeading">
            <header class="travel-atlas-heading"><p class="travel-kicker" id="travelMapHeading">TRAVEL ATLAS</p><div class="travel-atlas-actions"><div class="travel-map-stats"><p class="travel-coverage"><span>城市点亮率</span><strong id="travelCoverage">{{ travel_stats.coverage }}</strong></p><p class="travel-visited-count"><span>城市</span><strong id="travelPlaceCount">{{ travel_stats.visited }}</strong></p></div><button type="button" id="travelAllCities" hidden>← 全部城市</button></div></header>
            <nav id="travelAlbumCities" class="travel-album-cities" aria-label="已记录的城市" hidden></nav>
            <div class="travel-city-search" id="travelCitySearch">
                <label class="travel-search"><span class="visually-hidden">搜索城市</span><span aria-hidden="true">⌕</span><input type="search" id="travelSearch" role="combobox" placeholder="搜索城市" autocomplete="off" aria-autocomplete="list" aria-controls="travelCityList" aria-expanded="false"></label>
                <div class="travel-search-results" id="travelSearchResults" hidden><div id="travelCityList" role="listbox" aria-label="城市搜索结果"></div><p id="travelSearchEmpty" class="travel-search-empty" role="status" hidden>未找到城市</p></div>
            </div>
            <div class="travel-map-stage">
                <svg id="travelMap" xmlns="http://www.w3.org/2000/svg" viewBox="{{ travel_map_viewbox() }}" width="1000" height="760" role="group" tabindex="0" aria-labelledby="travelMapTitle" aria-describedby="travelKeyboardHint"><title id="travelMapTitle">中国城市旅行地图</title><g id="travelMapCanvas" aria-hidden="true">{{ travel_map_markup() | safe }}</g></svg>
                <div id="travelMapStatus" class="travel-map-status" role="status" hidden><button type="button" id="travelRetry" hidden>重新初始化</button></div>
                <div id="travelMapTooltip" class="travel-map-tooltip" hidden></div>
                <div class="travel-map-lens-layer" aria-hidden="true"><div id="travelMapLens" class="travel-map-lens" hidden><svg id="travelMagnifiedMap" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"></svg><span class="travel-map-lens-crosshair"></span><span id="travelMapLensLabel" class="travel-map-lens-label"></span></div></div>
                <div class="travel-map-tools" role="group" aria-label="地图缩放"><button type="button" data-travel-zoom="in" aria-label="放大地图" title="放大" disabled>＋</button><button type="button" data-travel-zoom="out" aria-label="缩小地图" title="缩小" disabled>−</button><button type="button" data-travel-zoom="reset" aria-label="恢复全国视图" title="全国视图" disabled>⌖</button></div>
            </div>
            <p id="travelKeyboardHint" class="visually-hidden">地图获得焦点后，可用方向键切换附近城市，按加号或减号缩放，按零恢复全国视图；也可搜索城市。</p>
        </section>
        <aside class="travel-notebook" id="travelDetails" aria-labelledby="travelCityName" hidden>
            <header class="travel-city-heading"><p class="travel-kicker" id="travelActiveProvince">城市相册</p><h2 id="travelCityName" tabindex="-1">选一座城市</h2><p id="travelCityMeta">暂无记录</p></header>
            <div id="travelEntries" class="travel-entries"></div>
            <div id="travelEmpty" class="travel-empty">{{ travel_scene() }}<p>暂无照片</p></div>
        </aside>
    </div>
    <p id="travelStatus" class="visually-hidden" role="status" aria-live="polite"></p>
    <script id="travelMapData" type="application/json">{{ travel_map_payload() | safe }}</script>
    <script id="travelJournalData" type="application/json">{{ travel_journal_payload(page) | safe }}</script>
    <noscript><p class="travel-noscript">交互地图需要启用 JavaScript；旅行记录的数据保存在这篇手记中。</p></noscript>
    <dialog id="travelPhotoViewer" class="travel-photo-viewer" aria-label="旅行照片预览"><header><span id="travelViewerCounter"></span><button type="button" data-close-photo aria-label="关闭照片">×</button></header><figure><div id="travelViewerStage" class="travel-viewer-stage"><img id="travelViewerImage" alt=""><div class="travel-photo-lens-layer" aria-hidden="true"><div id="travelPhotoLens" class="travel-photo-lens" hidden><canvas id="travelPhotoMagnifier" width="190" height="190"></canvas><span class="travel-map-lens-crosshair"></span><span class="travel-map-lens-label">3×</span></div></div></div><figcaption id="travelViewerCaption"></figcaption></figure><p id="travelViewerStatus" class="travel-viewer-status" role="status" aria-live="polite"></p><nav aria-label="浏览照片"><button type="button" data-prev-photo aria-label="上一张照片">←</button><button type="button" data-next-photo aria-label="下一张照片">→</button></nav></dialog>
</div>

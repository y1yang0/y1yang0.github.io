<header class="site-header">
    <div class="site-shell header-inner">
        <nav class="site-nav" aria-label="Main navigation">
            {% for item in theme.menu %}
            <a href="{{ url_for(item.url) }}" {% if item.target %}target="{{ item.target }}" rel="noopener noreferrer"{% endif %}{% if (item.url == '/' and is_home() and not page.travel_journal) or (item.section == 'journal' and page.travel_journal) or (item.url == '/archives' and is_archive()) or (item.url == '/about' and page.path == 'about/index.html') or (item.url == '/categories' and (is_category() or page.path == 'categories/index.html')) %} aria-current="page"{% endif %}>{{ item.name }}{% if item.target == '_blank' %}<span class="external-arrow" aria-hidden="true"> ↗</span>{% endif %}</a>
            {% endfor %}
            {% if theme.site.rss.enabled %}<a href="{{ url_for(theme.site.rss.path) }}">RSS</a>{% endif %}
        </nav>
        <div class="theme-picker" id="themePicker">
            <button id="themeToggle" class="theme-toggle" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="themeMenu" aria-label="切换主题 · 暖" title="切换主题 · 暖">
                <svg class="theme-icon" viewBox="0 0 20 20" aria-hidden="true">
                    <circle cx="10" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="1.3" />
                    <path d="M10 3a7 7 0 0 0 0 14Z" fill="currentColor" />
                </svg>
            </button>
            <div class="theme-menu" id="themeMenu" role="menu" aria-label="阅读主题" hidden>
                {% for value, label in { warm: '暖', dark: '黑', white: '白' } %}
                <button class="theme-option" type="button" role="menuitemradio" aria-checked="{{ 'true' if value == 'warm' else 'false' }}" data-theme-choice="{{ value }}" tabindex="-1">
                    <span class="theme-swatch theme-swatch-{{ value }}" aria-hidden="true"></span>
                    <span lang="zh-CN">{{ label }}</span>
                    <span class="theme-check" aria-hidden="true">✓</span>
                </button>
                {% endfor %}
            </div>
        </div>
    </div>
    {% if is_post() %}<div class="reading-progress" aria-hidden="true"><div id="readingProgress"></div></div>{% endif %}
</header>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f1e8" />
    <script>
        (() => {
            let theme = 'warm';
            try {
                const saved = localStorage.getItem('shiro-theme');
                theme = ['warm', 'dark', 'white'].includes(saved) ? saved : localStorage.getItem('shiro-dark-mode') === '1' ? 'dark' : 'warm';
            } catch (_) {}
            document.documentElement.dataset.theme = theme;
            document.documentElement.classList.toggle('dark', theme === 'dark');
        })();
    </script>
    <title>{% if is_home() %}{{ config.title | default("白夜書簡", true) }}{% elif is_post() or page.travel_journal %}{{ page.title }}{% else %} {{ config.title | default("白夜書簡", true) }}{% endif %}</title>

    <!-- SEO: description -->
    {% set seo_desc = page.description | default(page.excerpt | striptags | trim | truncate(160, true, '...') | default(config.description, true), true) %}
    {% if seo_desc %}
    <meta name="description" content="{{ seo_desc }}" />
    {% endif %}

    <!-- SEO: keywords -->
    {% set kw = page.keywords | default(config.keywords, true) %}
    {% if kw %}
    <meta name="keywords" content="{% if kw is string %}{{ kw }}{% else %}{{ kw | join(', ') }}{% endif %}" />
    {% endif %}

    <!-- SEO: canonical -->
    {% set canonical_path = path %}
    {% if page.travel_journal %}{% set canonical_path = 'journal/' %}{% endif %}
    <link rel="canonical" href="{{ full_url_for(canonical_path) }}" />

    <!-- Open Graph -->
    <meta property="og:type" content="{% if is_post() %}article{% else %}website{% endif %}" />
    <meta property="og:title" content="{% if is_home() %}{{ config.title | default("白夜書簡", true) }}{% else %}{{ page.title }}{% endif %}" />
    {% if seo_desc %}
    <meta property="og:description" content="{{ seo_desc }}" />
    {% endif %}
    <meta property="og:url" content="{{ full_url_for(canonical_path) }}" />
    <meta property="og:site_name" content="{{ config.title | default("白夜書簡", true) }}" />
    {% if is_post() %}
    <meta property="article:published_time" content="{{ page.date.toISOString() }}" />
    {% if page.updated %}<meta property="article:modified_time" content="{{ page.updated.toISOString() }}" />{% endif %}
    {% if config.author %}<meta property="article:author" content="{{ config.author }}" />{% endif %}
    {% endif %}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="{% if is_home() %}{{ config.title | default("白夜書簡", true) }}{% else %}{{ page.title }}{% endif %}" />
    {% if seo_desc %}
    <meta name="twitter:description" content="{{ seo_desc }}" />
    {% endif %}

    <!-- Favicon -->
    {% if theme.site.favicon %}
    <link rel="icon" href="{{ url_for(theme.site.favicon) }}" />
    {% endif %}

    <!-- Local type and journal styling keep first render independent of font CDNs. -->
    {% if is_home() %}
    <link rel="preload" href="{{ url_for('fonts/hero-yuji-syuku.woff2') }}" as="font" type="font/woff2" crossorigin>
    {% endif %}
    {% if has_gallery_images %}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.8.3/css/lightgallery.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.8.3/css/lg-zoom.min.css">
    {% endif %}
    <link rel="stylesheet" href="{{ journal_asset('css/journal.css') }}">
    {% if page.travel_journal %}<link rel="stylesheet" href="{{ journal_asset('css/travel-journal.css') }}">{% endif %}

    <!-- Analytics -->
    {% include "../analytics/google.njk" %}
    {% include "../analytics/clarity.njk" %}

</head>

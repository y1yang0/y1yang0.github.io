{% macro render_list(posts) %}
<div class="archive-list">
{% set currentYear = "" %}
{% for post in posts.toArray() %}
    {% set postYear = date(post.date, 'YYYY') %}
    {% if currentYear != postYear %}
        {% if currentYear != "" %}</div></section>{% endif %}
        {% set currentYear = postYear %}
        <section class="archive-year"><h2><span class="archive-year-label">{{ currentYear }}{% if currentYear == "2026" and is_archive() %}<sup class="archive-era-note" title="The AI era begins in 2026">AI era</sup>{% endif %}</span></h2><div>
    {% endif %}
    <article class="archive-entry"><time datetime="{{ date(post.date, 'YYYY-MM-DD') }}">{{ date(post.date, 'MMM DD') }}</time><h3><a href="{{ url_for(post.path) }}">{{ post.title }}</a></h3><a class="archive-open" href="{{ url_for(post.path) }}" aria-label="Read {{ post.title }}"><span aria-hidden="true">→</span></a></article>
{% endfor %}
{% if currentYear != "" %}</div></section>{% endif %}
</div>
{% endmacro %}

{% macro meta(post, show_all_cats=true, class="") %}
<div class="article-meta {{ class }}">
    <span class="article-meta-item"><a href="{{ url_for('archives/' + date(post.date, 'YYYY') + '/') }}"><time datetime="{{ date(post.date, 'YYYY-MM-DD') }}">{{ date(post.date, 'MMMM D, YYYY') }}</time></a></span>
    {% if post.content %}<span class="article-meta-item"><span aria-hidden="true">·</span><span>{{ wordcount(post.content) }} words</span></span>{% endif %}
    {% if post.categories.length %}<span class="article-meta-item"><span aria-hidden="true">·</span><span>{% for cat in post.categories.toArray() %}<a href="{{ url_for(cat.path) }}">{{ cat.name }}</a>{% if not loop.last %}<span aria-hidden="true"> / </span>{% endif %}{% endfor %}</span></span>{% endif %}
</div>
{% endmacro %}
{% macro render_tag(tag, show_count=false) %}<a class="tag-pill" href="{{ url_for(tag.path) }}">{{ tag.name }}{% if show_count %} <span>{{ tag.length }}</span>{% endif %}</a>{% endmacro %}
{% macro toc_button(content) %}
<div class="reading-tools" aria-label="Reading tools">
    <button type="button" id="copyArticleBtn" data-copy-icon="⧉" aria-label="Copy article" title="Copy article">⧉</button>
    <button type="button" id="toTopBtn" aria-label="Back to top" title="Back to top">↑</button>
    {% if content %}<button type="button" id="tocFab" aria-label="Contents" title="Contents" aria-haspopup="dialog" aria-controls="tocPanel" aria-expanded="false">≡</button>{% endif %}
</div>
{% if content %}<dialog id="tocPanel" class="toc-dialog" aria-labelledby="toc-title"><div class="toc-dialog-heading"><h2 id="toc-title">Contents</h2><button type="button" id="tocClose" aria-label="Close table of contents">×</button></div><nav aria-label="Table of contents">{{ content }}</nav></dialog>{% endif %}
{% endmacro %}
